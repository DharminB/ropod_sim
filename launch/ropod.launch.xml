<launch>
    <arg name="rate" default="5.0" />

    <arg name="init_x" default="0.0" />
    <arg name="init_y" default="0.0" />
    <arg name="init_theta" default="0.0" />
    <arg name="robot_id" default="ropod" />

    <arg name="model" default="ropod"/>

    <!-- Load the robot description from the urdf model -->
    <let name="robot_description"
        value="$(command 'xacro $(find-pkg-share ropod_sim)/description/xacro/$(var model).xacro')"/>

    <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher">
        <param name="robot_description" value="$(var robot_description)"/>
    </node>

    <!-- Spawn the robot using the arguments and robot description -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_spawn_model.launch.py">
        <arg name="world" value="empty"/>
        <arg name="topic" value="/robot_description"/>
        <arg name="entity_name" value="$(var robot_id)"/>
        <arg name="allow_renaming" value="False"/>
        <arg name="x" value="$(var init_x)"/>
        <arg name="y" value="$(var init_y)"/>
        <arg name="yaw" value="$(var init_theta)"/>
    </include>

    <node pkg="ros_gz_bridge" exec="parameter_bridge" name="ros_gz_bridge_$(var robot_id)">
        <param name="config_file" value="$(find-pkg-share ropod_sim)/config/bridge.yaml"/>
    </node>

    <!-- <node pkg="ropod_sim" name="dock_manager" type="dock_manager" output="screen"> -->
    <!--     <remap from="~dock" to="$(arg robot_id)/dock"/> -->
    <!--     <param name="robot_id" type="str" value="$(arg robot_id)"/> -->
    <!--     <param name="rate" type="double" value="$(arg rate)"/> -->
    <!-- </node> -->
</launch>
