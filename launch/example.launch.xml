<launch>
    <let name="robot" value="ropod" />

    <arg name="paused" default="false"/>
    <arg name="gui" default="true"/>
    <arg name="debug" default="false"/>
    <arg name="start_rviz" default="true"/>

    <!-- <arg name="global_frame" default="$(arg robot_id)/odom"/> -->

    <arg name="world_model_name" default="hall"/>

    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-prefix ropod_sim)/share"/>
    <set_env name="GZ_SIM_SYSTEM_PLUGIN_PATH" value="$(find-pkg-prefix ropod_sim)/lib/ropod_sim"/>
    <set_env name="GZ_SIM_SERVER_CONFIG_PATH" value="$(find-pkg-share ropod_sim)/config/server.config"/>

    <!-- Gazebo server -->
    <let name="gui_arg" value="" if="$(var gui)"/>
    <let name="gui_arg" value="-s" unless="$(var gui)"/>
    <let name="paused_arg" value="" if="$(var paused)"/>
    <let name="paused_arg" value="-r" unless="$(var paused)"/>
    <let name="debug_arg" value="-v 4" if="$(var debug)"/>
    <let name="debug_arg" value="-v 2" unless="$(var debug)"/>
    <let name="gui_config_file" value="$(find-pkg-share ropod_sim)/config/gui.config"/>
    <executable cmd="gz sim $(var gui_arg) $(var paused_arg) $(var debug_arg) empty.sdf --gui-config $(var gui_config_file)" output="screen"/>

    <!-- World -->
    <group>
        <let name="world_description"
             value="$(command 'xacro $(find-pkg-share ropod_sim)/world_description/$(var world_model_name).xacro')"/>

        <!-- spawn world model -->
        <include file="$(find-pkg-share ros_gz_sim)/launch/gz_spawn_model.launch.py">
            <arg name="world" value="empty"/>
            <arg name="model_string" value="'$(var world_description)'"/>
            <arg name="entity_name" value="world"/>
        </include>
    </group>

    <!-- Cart -->
    <!-- <include file="$(find ropod_sim)/ros/launch/cart.launch"> -->
    <!--     <arg name="cart_model" value="mobidik"/> -->
    <!--     <arg name="cart_id" value="cart_1"/> -->
    <!--     <arg name="cart_init_x" value="-2.0" /> -->
    <!--     <arg name="cart_init_y" value="0.0" /> -->
    <!--     <arg name="cart_init_theta" value="0.0" /> -->
    <!--     <arg name="global_frame" value="$(arg global_frame)" /> -->
    <!-- </include> -->

    <!-- Robot -->
    <include file="$(find-pkg-share ropod_sim)/launch/ropod.launch.xml">
        <arg name="model" value="ropod"/>
        <arg name="robot_id" value="$(var robot)" />
        <arg name="init_x" value="0.0" />
        <arg name="init_y" value="0.0" />
        <arg name="init_theta" value="0.0" />
    </include>

    <!-- RViz -->
    <group if="$(var start_rviz)">
        <node pkg="rviz2" exec="rviz2" name="ropod_sim_rviz"
              args="-d $(find-pkg-share ropod_sim)/config/example.rviz" />
    </group>

</launch>
